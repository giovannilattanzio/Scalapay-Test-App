#!/bin/sh
# Rejects commit messages that do not follow Conventional Commits.
subject=$(head -n 1 "$1")

case "$subject" in
  Merge\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|refactor|test|docs|chore|build|ci|perf|style|revert)(\([a-z0-9_-]+\))?!?: [^A-Z].*[^.]$'
if ! printf '%s\n' "$subject" | grep -qE "$pattern"; then
  echo "commit-msg: \"$subject\" is not a Conventional Commit." >&2
  echo "Expected: type(scope): lowercase imperative description, no trailing period" >&2
  echo "Types: feat fix refactor test docs chore build ci perf style revert" >&2
  exit 1
fi
